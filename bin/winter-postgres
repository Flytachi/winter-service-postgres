#!/bin/sh
# winter-postgres — prepares PostgreSQL's data directory, then runs the server in its own
# place (exec), so the stop signal the application sends reaches the server itself.
#
# Started by Flytachi\Winter\Service\Postgres\Postgres; its options are that class's:
#
#   --bin=DIR --version=N --data=DIR --socket=DIR --port=N --superuser=NAME --user=NAME
#   --database=NAME --encoding=E --locale=L [--host=ADDR] [-- server arguments…]
#
# Two roles: the superuser initdb makes — for this script and an administrator, through
# the socket only — and the application's role: a login without superuser rights, the
# owner of its database. The application's password, when there is one, comes in
# WINTER_POSTGRES_PASSWORD — never on the command line, which every process can read.
set -eu

# What it says, one line each; a warning or an error says so first, as PostgreSQL does —
# the service's parser reads it as that level.
say() { printf 'winter-postgres: %s\n' "$*" >&2; }
warn() { say "WARNING: $*"; }
fail() { say "ERROR: $*"; exit "${CODE:-1}"; }

BIN= VERSION= DATA= SOCKET= PORT= SUPERUSER= USER_NAME= ENCODING= LOCALE= HOST= DATABASE=
while [ $# -gt 0 ]; do
    case "$1" in
        --bin=*) BIN=${1#*=} ;;
        --version=*) VERSION=${1#*=} ;;
        --data=*) DATA=${1#*=} ;;
        --socket=*) SOCKET=${1#*=} ;;
        --port=*) PORT=${1#*=} ;;
        --superuser=*) SUPERUSER=${1#*=} ;;
        --user=*) USER_NAME=${1#*=} ;;
        --encoding=*) ENCODING=${1#*=} ;;
        --locale=*) LOCALE=${1#*=} ;;
        --host=*) HOST=${1#*=} ;;
        --database=*) DATABASE=${1#*=} ;;
        --) shift; break ;;
        *) CODE=2 fail "unknown option $1" ;;
    esac
    shift
done
PASSWORD=${WINTER_POSTGRES_PASSWORD:-}
unset WINTER_POSTGRES_PASSWORD

if [ ! -x "$BIN/postgres" ]; then
    fail "PostgreSQL $VERSION is not installed: no $BIN/postgres. Add it to the image: call service docker"
fi
mkdir -p "$SOCKET"

# Runs one statement in single-user mode — the server is not up yet — and fails on an
# ERROR: single-user mode exits 0 whatever the statement did.
single() {
    out=$(printf '%s\n' "$1" | "$BIN/postgres" --single -D "$DATA" postgres 2>&1) || fail "$out"
    case "$out" in
        *ERROR*) fail "$(printf '%s\n' "$out" | grep ERROR | head -1)" ;;
    esac
    printf '%s\n' "$out"
}

if [ ! -s "$DATA/PG_VERSION" ]; then
    if [ -n "$(ls -A "$DATA" 2>/dev/null)" ]; then
        fail "$DATA holds files but no PostgreSQL data: it is not initialised over them."
    fi
    mkdir -p "$DATA"
    chmod 700 "$DATA"
    # The superuser has no password: it signs in through the socket, inside the container.
    if ! "$BIN/initdb" -D "$DATA" --username="$SUPERUSER" --encoding="$ENCODING" --locale="$LOCALE" \
        --auth-local=trust --auth-host=scram-sha-256 >/dev/null; then
        fail "initdb failed for $DATA."
    fi
    say "initialised PostgreSQL $VERSION data in $DATA."
else
    found=$(cat "$DATA/PG_VERSION")
    if [ "$found" != "$VERSION" ]; then
        fail "the data in $DATA is PostgreSQL $found, the server is $VERSION: upgrade it with pg_upgrade, or set version: $found."
    fi
fi

# Kept in step with the code on every start: the role, its password, its database.
# A failure inside $(…) ends only the subshell: each one is checked, to end the script.
role=$(single "SELECT oid, rolsuper FROM pg_roles WHERE rolname = '$USER_NAME';") || exit 1
case "$role" in
    *'rolsuper = "t"'*)
        # Data made before the application had a role of its own: left working, said.
        case "$role" in
            *'oid = "10"'*) fix="it is the cluster's own superuser — move the data into a new cluster (pg_dump), or start with an empty data directory" ;;
            *) fix="ALTER ROLE \"$USER_NAME\" NOSUPERUSER, as $SUPERUSER" ;;
        esac
        warn "$USER_NAME is a superuser: the application connects with every right. To change it: $fix." ;;
    *'oid = '*) ;;
    *) single "CREATE ROLE \"$USER_NAME\" LOGIN;" >/dev/null; say "created role $USER_NAME." ;;
esac
if [ -n "$PASSWORD" ]; then
    quoted=$(printf '%s' "$PASSWORD" | sed "s/'/''/g")
    single "ALTER ROLE \"$USER_NAME\" PASSWORD '$quoted';" >/dev/null
else
    single "ALTER ROLE \"$USER_NAME\" PASSWORD NULL;" >/dev/null
fi
owner=$(single "SELECT pg_get_userbyid(datdba) AS owner FROM pg_database WHERE datname = '$DATABASE';") || exit 1
case "$owner" in
    *"owner = \"$USER_NAME\""*) ;;
    *'owner = '*)
        single "ALTER DATABASE \"$DATABASE\" OWNER TO \"$USER_NAME\";" >/dev/null
        say "database $DATABASE now belongs to $USER_NAME." ;;
    *)
        single "CREATE DATABASE \"$DATABASE\" OWNER \"$USER_NAME\";" >/dev/null
        say "created database $DATABASE." ;;
esac

# Who may connect, written whole on every start: through the socket, anyone — it is
# inside the container; over TCP, only the application's role, only to its database,
# with its password. Other containers reach the server only through an address that is
# not the loopback.
{
    echo '# Written by winter-postgres on every start: change the service, not this file.'
    echo 'local   all             all                                     trust'
    echo "host    $DATABASE       $USER_NAME       127.0.0.1/32            scram-sha-256"
    echo "host    $DATABASE       $USER_NAME       ::1/128                 scram-sha-256"
    if [ -n "$HOST" ] && [ "$HOST" != 127.0.0.1 ] && [ "$HOST" != localhost ] && [ "$HOST" != ::1 ]; then
        echo "host    $DATABASE       $USER_NAME       0.0.0.0/0               scram-sha-256"
        echo "host    $DATABASE       $USER_NAME       ::/0                    scram-sha-256"
    fi
} > "$DATA/pg_hba.conf"

exec "$BIN/postgres" -D "$DATA" -k "$SOCKET" -p "$PORT" -c "listen_addresses=$HOST" "$@"
